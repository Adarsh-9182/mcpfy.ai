# Required. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The origin Better Auth issues cookies for.
BETTER_AUTH_URL=http://localhost:3000

# Local development defaults to a file-backed libSQL database at .data/mcpfy.db.
# Point these at a hosted libSQL/Turso instance for anything shared.
DATABASE_URL=file:./.data/mcpfy.db
DATABASE_AUTH_TOKEN=

# Optional: enables "Continue with GitHub". Callback URL is
# <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
